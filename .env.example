# Server-only values. Configure in Vercel environment settings; never commit secrets.
AI_API_KEY=
# Explicitly select an available vision model supporting strict JSON schemas.
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Preferred modern server-only key (sb_secret_...). Legacy service_role remains accepted as fallback.
SUPABASE_SECRET_KEY=
# Supabase Auth UUID for the single permitted owner.
OWNER_USER_ID=
# Generate at least 32 random bytes.
PIPELINE_SIGNING_KEY=
# Optional Gold reference source; absence is shown as UNAVAILABLE.
TWELVE_DATA_API_KEY=
# Optional scheduler authentication; at least 32 random bytes.
CRON_SECRET=
